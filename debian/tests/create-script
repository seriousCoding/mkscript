#!/usr/bin/env bash
set -euo pipefail

sandbox=$(mktemp -d)

cleanup() {
  rm -rf "$sandbox"
}

trap cleanup EXIT

cd "$sandbox"
mkscript demo
test -x demo
diff -u <(printf '#!/usr/bin/env bash\n') demo

mkscript --strict strict-demo
test -x strict-demo
diff -u <(printf '#!/usr/bin/env bash\nset -euo pipefail\n') strict-demo

home_dir="$sandbox/home"
mkdir -p "$home_dir"

env HOME="$home_dir" mkscript demo -g
test -L "$home_dir/.local/bin/demo"
env HOME="$home_dir" mkscript demo -c | grep "$home_dir/.local/bin/demo"
printf 'yes\n' | env HOME="$home_dir" mkscript -r demo
test ! -e "$home_dir/.local/bin/demo"
