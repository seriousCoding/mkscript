#!/usr/bin/env bash
set -euo pipefail

sandbox=$(mktemp -d)

cleanup() {
  rm -rf "$sandbox"
}

trap cleanup EXIT

cd "$sandbox"
mkscript demo
test -x demo
diff -u <(printf '#!/usr/bin/env bash\n') demo

mkscript --strict strict-demo
test -x strict-demo
diff -u <(printf '#!/usr/bin/env bash\nset -euo pipefail\n') strict-demo
