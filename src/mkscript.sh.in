#!/usr/bin/env bash
set -euo pipefail

readonly MKSCRIPT_VERSION='@VERSION@'
readonly MKSCRIPT_NAME='mkscript'
readonly EX_USAGE=64
readonly EX_CANTCREAT=73

usage() {
  cat <<'EOF'
Usage:
  mkscript [OPTION]... PATH
  mkscript -mv [--global] SOURCE TARGET
  mkscript -f|--files [DEPTH]
  mkscript -f|--files NAME [NAME ...]

Create a new file from a Bash, Terraform, or Ansible template.
Global link management applies to Bash templates only.

Options:
  -t, --template TEMPLATE
                  use bash, terraform, or ansible
  -f, --files     list matching files under the current tree
                  DEPTH 0-9 limits subfolder scanning; 0 means current folder only
                  NAME arguments, or piped newline-separated names, perform lookup mode
                  and print both the resolved path and its parent directory
  -mv             move an existing Bash script to a new path
  -s, --strict    add "set -euo pipefail" after the shebang
  -g, --global    create a global symlink for the new Bash script
  -l, --link      create only a global symlink for an existing Bash file
  -c              check whether the expected global Bash symlink exists
  -r              remove the expected global Bash symlink after confirmation
      --help      display this help and exit
      --version   output version information and exit
EOF
}

print_version() {
  printf '%s %s\n' "$MKSCRIPT_NAME" "$MKSCRIPT_VERSION"
}

fail_usage() {
  printf '%s: %s\n' "$MKSCRIPT_NAME" "$1" >&2
  printf "Try '%s --help' for more information.\n" "$MKSCRIPT_NAME" >&2
  exit "$EX_USAGE"
}

fail_create() {
  printf '%s: %s\n' "$MKSCRIPT_NAME" "$1" >&2
  exit "$EX_CANTCREAT"
}

validate_files_depth() {
  local depth=${1-}

  case $depth in
    ''|[0-9])
      ;;
    *)
      fail_usage 'file listing depth must be a single digit from 0 to 9'
      ;;
  esac
}

is_single_digit() {
  case ${1-} in
    [0-9])
      return 0
      ;;
  esac

  return 1
}

is_digits_only() {
  case ${1-} in
    ''|*[!0-9]*)
      return 1
      ;;
  esac

  return 0
}

validate_template() {
  case $1 in
    bash|terraform|ansible)
      ;;
    *)
      fail_usage "unsupported template: $1 (expected bash, terraform, or ansible)"
      ;;
  esac
}

path_in_tree() {
  local path=$1
  local tree_root=$2

  case $path in
    "$tree_root"|"$tree_root"/*)
      return 0
      ;;
  esac

  return 1
}

parent_dir() {
  local path=$1
  local parent

  case $path in
    */*)
      parent=${path%/*}
      if [ -z "$parent" ]; then
        printf '/\n'
      else
        printf '%s\n' "$parent"
      fi
      ;;
    *)
      printf '.\n'
      ;;
  esac
}

base_name() {
  local path=$1

  case $path in
    */)
      printf '\n'
      ;;
    */*)
      printf '%s\n' "${path##*/}"
      ;;
    *)
      printf '%s\n' "$path"
      ;;
  esac
}

safe_command_path() {
  local path=$1

  case $path in
    -*)
      printf './%s\n' "$path"
      ;;
    *)
      printf '%s\n' "$path"
      ;;
  esac
}

absolute_path() {
  local path=$1
  local parent
  local base
  local resolved_parent

  parent=$(parent_dir "$path")
  base=$(base_name "$path")

  (
    cd "$parent" >/dev/null 2>&1 || exit 1
    resolved_parent=$(pwd -P)
    if [ "$resolved_parent" = '/' ]; then
      printf '/%s\n' "$base"
    else
      printf '%s/%s\n' "$resolved_parent" "$base"
    fi
  )
}

resolve_link_target_path() {
  local link_path=$1
  local link_target
  local link_parent

  link_target=$(readlink "$link_path" 2>/dev/null || true)
  if [ -z "$link_target" ]; then
    return 1
  fi

  case $link_target in
    /*)
      absolute_path "$link_target"
      ;;
    *)
      link_parent=$(parent_dir "$link_path")
      (
        cd "$link_parent" >/dev/null 2>&1 || exit 1
        absolute_path "$link_target"
      )
      ;;
  esac
}

platform_name() {
  uname -s 2>/dev/null || printf '\n'
}

path_has_entry() {
  local needle=$1
  local path_value=${PATH:-}
  local path_entry
  local old_ifs=$IFS

  IFS=:
  for path_entry in $path_value; do
    if [ "$path_entry" = "$needle" ]; then
      IFS=$old_ifs
      return 0
    fi
  done
  IFS=$old_ifs

  return 1
}

darwin_global_bin_dir() {
  local home_dir=$1
  local path_value=${PATH:-}
  local path_entry
  local parent_name
  local old_ifs=$IFS

  if path_has_entry "$home_dir/.local/bin"; then
    printf '%s/.local/bin\n' "$home_dir"
    return 0
  fi

  if path_has_entry "$home_dir/bin"; then
    printf '%s/bin\n' "$home_dir"
    return 0
  fi

  IFS=:
  for path_entry in $path_value; do
    case $path_entry in
      "$home_dir"/*/bin)
        if [ -e "$path_entry" ] && [ ! -d "$path_entry" ]; then
          continue
        fi

        parent_name=${path_entry%/bin}
        parent_name=${parent_name##*/}

        case $parent_name in
          *local*)
            IFS=$old_ifs
            printf '%s\n' "$path_entry"
            return 0
            ;;
        esac
        ;;
    esac
  done
  IFS=$old_ifs

  return 1
}

global_bin_dir() {
  local home_dir=${HOME:-}
  local system_name

  if [ -z "$home_dir" ]; then
    fail_create 'HOME is not set; cannot determine the global bin directory'
  fi

  system_name=$(platform_name)

  if [ "$system_name" = 'Darwin' ]; then
    if darwin_global_bin_dir "$home_dir"; then
      return 0
    fi
  fi

  printf '%s/.local/bin\n' "$home_dir"
}

global_link_path() {
  local target=$1
  local base

  base=$(base_name "$target")
  printf '%s/%s\n' "$(global_bin_dir)" "$base"
}

validate_target() {
  local target=$1
  local parent
  local base

  parent=$(parent_dir "$target")
  base=$(base_name "$target")

  if [ -z "$base" ] || [ "$base" = '.' ] || [ "$base" = '..' ]; then
    fail_create "output path must name a file: $target"
  fi

  if [ ! -d "$parent" ]; then
    fail_create "parent directory does not exist: $parent"
  fi

  if [ -d "$target" ]; then
    fail_create "refusing to overwrite existing directory: $target"
  fi

  if [ -e "$target" ] || [ -L "$target" ]; then
    fail_create "refusing to overwrite existing path: $target"
  fi
}

validate_global_link() {
  local link_path=$1
  local global_dir

  global_dir=$(parent_dir "$link_path")

  if [ -e "$global_dir" ] || [ -L "$global_dir" ]; then
    if [ ! -d "$global_dir" ]; then
      fail_create "global bin directory is not a directory: $global_dir"
    fi
  fi

  if [ -d "$link_path" ]; then
    fail_create "refusing to overwrite existing global path: $link_path"
  fi

  if [ -e "$link_path" ] || [ -L "$link_path" ]; then
    fail_create "refusing to overwrite existing global path: $link_path"
  fi
}

validate_link_source() {
  local target=$1

  if [ -d "$target" ]; then
    fail_create "cannot link a directory: $target"
  fi

  if [ ! -e "$target" ] && [ ! -L "$target" ]; then
    fail_create "cannot link missing path: $target"
  fi
}

validate_move_source() {
  local source=$1

  if [ -d "$source" ]; then
    fail_create "cannot move a directory: $source"
  fi

  if [ ! -e "$source" ] && [ ! -L "$source" ]; then
    fail_create "cannot move missing path: $source"
  fi

  if [ -L "$source" ]; then
    fail_create "cannot move a symlink source: $source"
  fi
}

validate_existing_global_link() {
  local link_path=$1

  if [ -L "$link_path" ]; then
    return 0
  fi

  if [ -e "$link_path" ]; then
    fail_create "global path exists but is not a symlink: $link_path"
  fi

  return 1
}

write_header() {
  local target_name=$1
  local template=$2
  local creator
  local created_date
  local label

  creator=$(id -un 2>/dev/null || true)
  if [ -z "$creator" ]; then
    creator=${LOGNAME:-${USER:-}}
  fi
  if [ -z "$creator" ]; then
    fail_create 'failed to determine creator name'
  fi

  created_date=$(date '+%Y-%m-%d' 2>/dev/null || true)
  if [ -z "$created_date" ]; then
    fail_create 'failed to determine current date'
  fi

  case $template in
    bash)
      label='Script'
      ;;
    *)
      label='File'
      ;;
  esac

  {
    printf '# %s: %s\n' "$label" "$target_name"
    printf '# Description:\n'
    printf '# Created: %s\n' "$created_date"
    printf '# Creator: %s\n' "$creator"
  }
}

write_template() {
  local destination=$1
  local template=$2
  local strict_enabled=$3
  local target_name

  target_name=$(base_name "$destination")

  case $template in
    bash)
      {
        printf '#!/usr/bin/env bash\n'
        write_header "$target_name" bash
        if [ "$strict_enabled" -eq 1 ]; then
          printf 'set -euo pipefail\n'
        fi
      } > "$destination"
      ;;
    terraform)
      {
        write_header "$target_name" terraform
        printf '\n'
        printf 'terraform {\n'
        printf '  required_version = ">= 1.0.0"\n'
        printf '}\n'
      } > "$destination"
      ;;
    ansible)
      {
        write_header "$target_name" ansible
        printf '\n'
        printf -- '---\n'
        printf -- '- name: %s\n' "$target_name"
        printf '  hosts: all\n'
        printf '  gather_facts: false\n'
        printf '  tasks: []\n'
      } > "$destination"
      ;;
  esac
}

template_mode() {
  case $1 in
    bash)
      printf '755\n'
      ;;
    *)
      printf '644\n'
      ;;
  esac
}

permission_mode() {
  local target=$1
  local mode

  if mode=$(stat -c '%a' "$target" 2>/dev/null); then
    printf '%s\n' "$mode"
    return 0
  fi

  if mode=$(stat -f '%Lp' "$target" 2>/dev/null); then
    printf '%s\n' "$mode"
    return 0
  fi

  fail_create "failed to determine permissions: $target"
}

kind_for_file() {
  local is_shell=$1
  local is_executable=$2

  if [ "$is_shell" -eq 1 ] && [ "$is_executable" -eq 1 ]; then
    printf 'sh+exec\n'
    return 0
  fi

  if [ "$is_shell" -eq 1 ]; then
    printf 'sh\n'
    return 0
  fi

  if [ "$is_executable" -eq 1 ]; then
    printf 'exec\n'
    return 0
  fi

  printf 'file\n'
}

lookup_exact_path() {
  local requested=$1

  if [ -e "$requested" ] || [ -L "$requested" ]; then
    absolute_path "$requested"
    return 0
  fi

  return 1
}

lookup_command_path() {
  local requested=$1
  local resolved

  resolved=$(type -P -- "$requested" 2>/dev/null || true)
  if [ -n "$resolved" ]; then
    absolute_path "$resolved"
    return 0
  fi

  return 1
}

lookup_filename_in_current_tree() {
  local requested=$1
  local candidate

  candidate=$(find . \( -type f -o -type l \) -name "$requested" -print 2>/dev/null | LC_ALL=C sort | head -n 1 || true)
  if [ -n "$candidate" ]; then
    absolute_path "$candidate"
    return 0
  fi

  return 1
}

lookup_filename_with_mdfind() {
  local requested=$1
  local candidate

  if ! command -v mdfind >/dev/null 2>&1; then
    return 1
  fi

  while IFS= read -r candidate; do
    if [ "$(base_name "$candidate")" = "$requested" ] && { [ -f "$candidate" ] || [ -L "$candidate" ] || [ -x "$candidate" ]; }; then
      absolute_path "$candidate"
      return 0
    fi
  done < <(mdfind -name "$requested" 2>/dev/null || true)

  return 1
}

lookup_filename_with_locate() {
  local requested=$1
  local candidate

  if ! command -v locate >/dev/null 2>&1; then
    return 1
  fi

  while IFS= read -r candidate; do
    if [ "$(base_name "$candidate")" = "$requested" ] && { [ -f "$candidate" ] || [ -L "$candidate" ] || [ -x "$candidate" ]; }; then
      absolute_path "$candidate"
      return 0
    fi
  done < <(locate -- "$requested" 2>/dev/null || true)

  return 1
}

lookup_filename_with_find() {
  local requested=$1
  local system_name
  local home_dir=${HOME:-}
  local -a search_roots=()

  system_name=$(platform_name)

  case $system_name in
    Darwin)
      search_roots=(/Applications /Library /System /Users /opt /usr /bin /sbin /private/etc /private/var)
      ;;
    *)
      search_roots=(/usr/local /opt /usr /bin /sbin /home /root /etc /var)
      ;;
  esac

  if [ -n "$home_dir" ]; then
    search_roots+=("$home_dir")
  fi

  find "${search_roots[@]}" \( -type f -o -type l \) -name "$requested" -print 2>/dev/null | LC_ALL=C sort | head -n 1
}

lookup_requested_name() {
  local requested=$1
  local search_name
  local resolved

  if resolved=$(lookup_exact_path "$requested" 2>/dev/null); then
    printf 'path\t%s\n' "$resolved"
    return 0
  fi

  search_name=$(base_name "$requested")

  if resolved=$(lookup_command_path "$search_name" 2>/dev/null); then
    printf 'command\t%s\n' "$resolved"
    return 0
  fi

  if resolved=$(lookup_filename_in_current_tree "$search_name" 2>/dev/null); then
    printf 'file\t%s\n' "$resolved"
    return 0
  fi

  if resolved=$(lookup_filename_with_mdfind "$search_name" 2>/dev/null); then
    printf 'file\t%s\n' "$resolved"
    return 0
  fi

  if command -v mdfind >/dev/null 2>&1; then
    return 1
  fi

  if resolved=$(lookup_filename_with_locate "$search_name" 2>/dev/null); then
    printf 'file\t%s\n' "$resolved"
    return 0
  fi

  resolved=$(lookup_filename_with_find "$search_name" 2>/dev/null || true)
  if [ -n "$resolved" ]; then
    if resolved=$(absolute_path "$resolved" 2>/dev/null); then
      printf 'file\t%s\n' "$resolved"
      return 0
    fi

    printf 'file\t%s\n' "$resolved"
    return 0
  fi

  return 1
}

lookup_requested_files() {
  local terms_file=$1
  local rows_file
  local requested
  local lookup_result
  local kind
  local location
  local directory
  local found_label
  local status=0

  rows_file=$(mktemp)

  while IFS= read -r requested; do
    [ -n "$requested" ] || continue

    found_label='no'
    kind='missing'
    location='-'
    directory='-'

    if lookup_result=$(lookup_requested_name "$requested" 2>/dev/null); then
      kind=${lookup_result%%$'\t'*}
      location=${lookup_result#*$'\t'}
      directory=$(parent_dir "$location")
      found_label='yes'
    else
      status=1
    fi

    printf '%s\t%s\t%s\t%s\t%s\n' "$requested" "$found_label" "$kind" "$location" "$directory" >> "$rows_file"
  done < "$terms_file"

  awk -F '\t' '
    BEGIN {
      query_width = length("QUERY")
      type_width = length("TYPE")
      location_width = length("LOCATION")
      directory_width = length("DIRECTORY")
    }
    {
      rows[NR] = $0
      if (length($1) > query_width) {
        query_width = length($1)
      }
      if (length($3) > type_width) {
        type_width = length($3)
      }
      if (length($4) > location_width) {
        location_width = length($4)
      }
      if (length($5) > directory_width) {
        directory_width = length($5)
      }
    }
    END {
      printf "%-*s  %-5s  %-*s  %-*s  %-*s\n", query_width, "QUERY", "FOUND", type_width, "TYPE", location_width, "LOCATION", directory_width, "DIRECTORY"
      for (row_number = 1; row_number <= NR; row_number++) {
        split(rows[row_number], fields, "\t")
        printf "%-*s  %-5s  %-*s  %-*s  %-*s\n", query_width, fields[1], fields[2], type_width, fields[3], location_width, fields[4], directory_width, fields[5]
      }
    }
  ' "$rows_file"

  rm -f "$rows_file"
  return "$status"
}

list_script_files() {
  local depth=${1-}
  local tree_root
  local global_dir
  local absolute_global_dir=''
  local global_targets_file
  local rows_file
  local search_maxdepth
  local path
  local absolute_file
  local absolute_target
  local is_shell
  local is_executable
  local is_global
  local kind
  local exec_label
  local global_label
  local -a tree_find_args

  validate_files_depth "$depth"

  tree_root=$(pwd -P)
  global_dir=$(global_bin_dir)
  global_targets_file=$(mktemp)
  rows_file=$(mktemp)
  tree_find_args=(.)

  if [ -n "$depth" ]; then
    search_maxdepth=$((depth + 1))
    tree_find_args+=(-maxdepth "$search_maxdepth")
  fi

  tree_find_args+=( \( -type f -o -type l \) -print )

  if [ -e "$global_dir" ] || [ -L "$global_dir" ]; then
    if [ ! -d "$global_dir" ]; then
      rm -f "$global_targets_file" "$rows_file"
      fail_create "global bin directory is not a directory: $global_dir"
    fi
  fi

  if [ -d "$global_dir" ]; then
    absolute_global_dir=$(
      cd "$global_dir" >/dev/null 2>&1 && pwd -P
    )

    while IFS= read -r path; do
      absolute_target=$(resolve_link_target_path "$path") || continue

      if path_in_tree "$absolute_target" "$tree_root"; then
        printf '%s\n' "$absolute_target" >> "$global_targets_file"
      fi
    done < <(find "$global_dir" -mindepth 1 -maxdepth 1 -type l -print 2>/dev/null | LC_ALL=C sort)
  fi

  if [ -s "$global_targets_file" ]; then
    LC_ALL=C sort -u "$global_targets_file" -o "$global_targets_file"
  fi

  while IFS= read -r path; do
    if [ ! -e "$path" ] && [ ! -L "$path" ]; then
      continue
    fi

    if [ -L "$path" ] && [ ! -e "$path" ]; then
      continue
    fi

    is_shell=0
    case $path in
      *.sh)
        is_shell=1
        ;;
    esac

    is_executable=0
    if [ -x "$path" ]; then
      is_executable=1
    fi

    absolute_file=$(absolute_path "$path") || {
      rm -f "$global_targets_file" "$rows_file"
      fail_create "failed to resolve file path: $path"
    }

    if [ -n "$absolute_global_dir" ] && [ -L "$path" ] && path_in_tree "$absolute_file" "$absolute_global_dir"; then
      continue
    fi

    is_global=0
    if [ -s "$global_targets_file" ] && grep -Fqx "$absolute_file" "$global_targets_file"; then
      is_global=1
    fi

    if [ "$is_shell" -eq 0 ] && [ "$is_executable" -eq 0 ] && [ "$is_global" -eq 0 ]; then
      continue
    fi

    kind=$(kind_for_file "$is_shell" "$is_executable")
    exec_label='no'
    global_label='no'

    if [ "$is_executable" -eq 1 ]; then
      exec_label='yes'
    fi

    if [ "$is_global" -eq 1 ]; then
      global_label='yes'
    fi

    printf '%s\t%s\t%s\t%s\n' "$path" "$kind" "$exec_label" "$global_label" >> "$rows_file"
  done < <(find "${tree_find_args[@]}" 2>/dev/null | LC_ALL=C sort)

  if [ ! -s "$rows_file" ]; then
    rm -f "$global_targets_file" "$rows_file"
    printf "No matching script files found under '.'\n"
    return 0
  fi

  awk -F '\t' '
    BEGIN {
      path_width = length("PATH")
      kind_width = length("KIND")
    }
    {
      rows[NR] = $0
      if (length($1) > path_width) {
        path_width = length($1)
      }
      if (length($2) > kind_width) {
        kind_width = length($2)
      }
    }
    END {
      printf "%-*s  %-*s  %-4s  %-6s\n", path_width, "PATH", kind_width, "KIND", "EXEC", "GLOBAL"
      for (row_number = 1; row_number <= NR; row_number++) {
        split(rows[row_number], fields, "\t")
        printf "%-*s  %-*s  %-4s  %-6s\n", path_width, fields[1], kind_width, fields[2], fields[3], fields[4]
      }
    }
  ' "$rows_file"

  rm -f "$global_targets_file" "$rows_file"
}

cleanup_target() {
  local target=$1
  local command_target

  command_target=$(safe_command_path "$target")
  rm -f "$command_target"
}

create_target() {
  local target=$1
  local template=$2
  local strict_enabled=$3
  local command_target
  local mode

  command_target=$(safe_command_path "$target")
  mode=$(template_mode "$template")

  if ! ( set -o noclobber; : > "$target" ) 2>/dev/null; then
    fail_create "refusing to overwrite existing path: $target"
  fi

  if ! write_template "$target" "$template" "$strict_enabled"; then
    cleanup_target "$target"
    fail_create "failed to write file: $target"
  fi

  if ! chmod "$mode" "$command_target"; then
    cleanup_target "$target"
    fail_create "failed to set target permissions: $target"
  fi
}

create_global_link() {
  local absolute_target=$1
  local link_path=$2
  local global_dir

  global_dir=$(parent_dir "$link_path")

  mkdir -p "$global_dir" && ln -s "$absolute_target" "$link_path"
}

managed_global_link_path() {
  local target=$1
  local expected_absolute=$2
  local link_path
  local link_target

  link_path=$(global_link_path "$target")

  if [ -L "$link_path" ]; then
    link_target=$(readlink "$link_path" 2>/dev/null || true)
    if [ -z "$link_target" ]; then
      fail_create "failed to read global link target: $link_path"
    fi

    if [ "$link_target" != "$expected_absolute" ]; then
      fail_create "global link does not point to source path: $link_path"
    fi

    printf '%s\n' "$link_path"
    return 0
  fi

  if [ -e "$link_path" ]; then
    fail_create "global path exists but is not a symlink: $link_path"
  fi

  return 1
}

confirm_link_action() {
  local target=$1
  local link_path=$2
  local reply

  printf "Are you sure you want to link source path '%s' to '%s'? [y/N] " "$target" "$link_path"

  if ! IFS= read -r reply; then
    fail_create "link cancelled: $target"
  fi

  case $reply in
    [Yy]|[Yy][Ee][Ss])
      ;;
    *)
      fail_create "link cancelled: $target"
      ;;
  esac
}

confirm_remove_action() {
  local target_name=$1
  local link_path=$2
  local reply

  printf "Are you sure you want to remove link for '%s' from '%s'? [y/N] " "$target_name" "$link_path"

  if ! IFS= read -r reply; then
    fail_create "link removal cancelled: $target_name"
  fi

  case $reply in
    [Yy]|[Yy][Ee][Ss])
      ;;
    *)
      fail_create "link removal cancelled: $target_name"
      ;;
  esac
}

check_global_link() {
  local target=$1
  local target_name
  local link_path

  target_name=$(base_name "$target")
  link_path=$(global_link_path "$target")

  if validate_existing_global_link "$link_path"; then
    printf "Global link for '%s': '%s'\n" "$target_name" "$link_path"
    exit 0
  fi

  printf "No global link exists for '%s' at '%s'\n" "$target_name" "$link_path"
  exit 1
}

remove_global_link() {
  local target=$1
  local target_name
  local link_path

  target_name=$(base_name "$target")
  link_path=$(global_link_path "$target")

  if ! validate_existing_global_link "$link_path"; then
    printf "No global link exists for '%s' at '%s'\n" "$target_name" "$link_path"
    exit 1
  fi

  confirm_remove_action "$target_name" "$link_path"

  if ! rm -f "$link_path"; then
    fail_create "failed to remove global link: $link_path"
  fi

  printf "Removed link for '%s' from '%s'\n" "$target_name" "$link_path"
}

move_script() {
  local source=$1
  local target=$2
  local force_global_link=$3
  local source_absolute
  local target_absolute
  local source_mode
  local source_link_path=''
  local source_had_link=0
  local recreate_link=0
  local target_link_path=''
  local command_target

  validate_move_source "$source"
  validate_target "$target"

  source_absolute=$(absolute_path "$source") || fail_create "failed to resolve absolute path: $source"
  source_mode=$(permission_mode "$source")

  if source_link_path=$(managed_global_link_path "$source" "$source_absolute"); then
    source_had_link=1
  fi

  if [ "$source_had_link" -eq 1 ] || [ "$force_global_link" -eq 1 ]; then
    recreate_link=1
    target_link_path=$(global_link_path "$target")

    if [ "$source_had_link" -eq 1 ] && [ "$source_link_path" = "$target_link_path" ]; then
      :
    else
      validate_global_link "$target_link_path"
    fi
  fi

  if ! mv "$source" "$target"; then
    fail_create "failed to move script: $source -> $target"
  fi

  command_target=$(safe_command_path "$target")

  if ! chmod "$source_mode" "$command_target"; then
    fail_create "script moved to '$target' but failed to restore permissions"
  fi

  target_absolute=$(absolute_path "$target") || fail_create "script moved to '$target' but failed to resolve the new absolute path"

  printf 'Moved script: %s -> %s\n' "$source" "$target"

  if [ "$source_had_link" -eq 1 ]; then
    if ! rm -f "$source_link_path"; then
      fail_create "script moved to '$target' but failed to remove old global link: $source_link_path"
    fi

    printf 'Removed global link: %s\n' "$source_link_path"
  fi

  if [ "$recreate_link" -eq 1 ]; then
    if ! create_global_link "$target_absolute" "$target_link_path"; then
      fail_create "script moved to '$target' but failed to create global link: $target_link_path"
    fi

    printf 'Created global link: %s -> %s\n' "$target_link_path" "$target_absolute"
  fi
}

main() {
  local strict_enabled=0
  local global_enabled=0
  local link_only=0
  local check_only=0
  local remove_only=0
  local files_only=0
  local files_depth=''
  local files_mode='list'
  local lookup_terms_file=''
  local stdin_terms_file=''
  local stdin_term_count=0
  local total_lookup_terms=0
  local line=''
  local move_only=0
  local literal_args=0
  local template='bash'
  local template_specified=0
  local positional_count=0
  local first_path=''
  local second_path=''
  local source=''
  local target=''
  local link_path=''
  local absolute_target=''
  local -a positional_args=()

  while [ $# -gt 0 ]; do
    if [ "$literal_args" -eq 0 ]; then
      case $1 in
        -t|--template)
          if [ $# -lt 2 ] || [ -z "${2-}" ]; then
            fail_usage "missing value for --template"
          fi
          template_specified=1
          template=$2
          shift 2
          continue
          ;;
        --template=*)
          template=${1#*=}
          if [ -z "$template" ]; then
            fail_usage "missing value for --template"
          fi
          template_specified=1
          shift
          continue
          ;;
        -f|--files)
          files_only=1
          shift
          continue
          ;;
        -mv)
          move_only=1
          shift
          continue
          ;;
        -s|--strict)
          strict_enabled=1
          shift
          continue
          ;;
        -g|--global)
          global_enabled=1
          shift
          continue
          ;;
        -l|--link)
          link_only=1
          shift
          continue
          ;;
        -c)
          check_only=1
          shift
          continue
          ;;
        -r)
          remove_only=1
          shift
          continue
          ;;
        --help)
          usage
          exit 0
          ;;
        --version)
          print_version
          exit 0
          ;;
        --)
          literal_args=1
          shift
          continue
          ;;
        -*)
          fail_usage "unknown option: $1"
          ;;
      esac
    fi

    positional_args+=("$1")
    positional_count=${#positional_args[@]}
    shift
  done

  validate_template "$template"

  if [ "$files_only" -eq 1 ]; then
    if [ ! -t 0 ]; then
      stdin_terms_file=$(mktemp)
      while IFS= read -r line || [ -n "$line" ]; do
        [ -n "$line" ] || continue
        printf '%s\n' "$line" >> "$stdin_terms_file"
      done
      stdin_term_count=$(awk 'END { print NR + 0 }' "$stdin_terms_file")
    fi

    if [ "$stdin_term_count" -eq 0 ] && [ "$positional_count" -eq 0 ]; then
      files_mode='list'
    elif [ "$stdin_term_count" -eq 0 ] && [ "$positional_count" -eq 1 ] && is_single_digit "${positional_args[0]}"; then
      files_mode='list'
      files_depth=${positional_args[0]}
      validate_files_depth "$files_depth"
    elif [ "$stdin_term_count" -eq 0 ] && [ "$positional_count" -eq 1 ] && is_digits_only "${positional_args[0]}"; then
      rm -f "$stdin_terms_file"
      fail_usage "file listing depth must be a single digit from 0 to 9"
    else
      files_mode='lookup'

      if [ "$stdin_term_count" -gt 0 ] && [ "$positional_count" -eq 1 ] && is_single_digit "${positional_args[0]}"; then
        rm -f "$stdin_terms_file"
        fail_usage "cannot combine file listing depth with lookup input"
      fi

      total_lookup_terms=$((stdin_term_count + positional_count))
      if [ "$total_lookup_terms" -gt 9 ]; then
        rm -f "$stdin_terms_file"
        fail_usage "lookup mode accepts at most 9 names"
      fi

      lookup_terms_file=$(mktemp)
      if [ "$stdin_term_count" -gt 0 ]; then
        cat "$stdin_terms_file" >> "$lookup_terms_file"
      fi
      if [ "$positional_count" -gt 0 ]; then
        printf '%s\n' "${positional_args[@]}" >> "$lookup_terms_file"
      fi
    fi
  elif [ "$move_only" -eq 1 ]; then
    if [ "$positional_count" -ne 2 ]; then
      fail_usage "move mode requires source and target paths"
    fi

    first_path=${positional_args[0]}
    second_path=${positional_args[1]}
    source=$first_path
    target=$second_path
  else
    if [ "$positional_count" -eq 0 ]; then
      fail_usage "missing output path"
    fi

    if [ "$positional_count" -ne 1 ]; then
      fail_usage "expected exactly one output path"
    fi

    first_path=${positional_args[0]}
    target=$first_path
  fi

  if [ "$link_only" -eq 1 ] && [ "$global_enabled" -eq 1 ]; then
    fail_usage "cannot combine --link with --global"
  fi

  if [ "$link_only" -eq 1 ] && [ "$strict_enabled" -eq 1 ]; then
    fail_usage "cannot combine --link with --strict"
  fi

  if [ "$link_only" -eq 1 ] && [ "$check_only" -eq 1 ]; then
    fail_usage "cannot combine --link with -c"
  fi

  if [ "$link_only" -eq 1 ] && [ "$remove_only" -eq 1 ]; then
    fail_usage "cannot combine --link with -r"
  fi

  if [ "$check_only" -eq 1 ] && [ "$remove_only" -eq 1 ]; then
    fail_usage "cannot combine -c with -r"
  fi

  if [ "$check_only" -eq 1 ] && [ "$global_enabled" -eq 1 ]; then
    fail_usage "cannot combine -c with --global"
  fi

  if [ "$check_only" -eq 1 ] && [ "$strict_enabled" -eq 1 ]; then
    fail_usage "cannot combine -c with --strict"
  fi

  if [ "$remove_only" -eq 1 ] && [ "$global_enabled" -eq 1 ]; then
    fail_usage "cannot combine -r with --global"
  fi

  if [ "$remove_only" -eq 1 ] && [ "$strict_enabled" -eq 1 ]; then
    fail_usage "cannot combine -r with --strict"
  fi

  if [ "$move_only" -eq 1 ] && [ "$strict_enabled" -eq 1 ]; then
    fail_usage "cannot combine -mv with --strict"
  fi

  if [ "$move_only" -eq 1 ] && [ "$link_only" -eq 1 ]; then
    fail_usage "cannot combine -mv with --link"
  fi

  if [ "$move_only" -eq 1 ] && [ "$check_only" -eq 1 ]; then
    fail_usage "cannot combine -mv with -c"
  fi

  if [ "$move_only" -eq 1 ] && [ "$remove_only" -eq 1 ]; then
    fail_usage "cannot combine -mv with -r"
  fi

  if [ "$files_only" -eq 1 ] && [ "$global_enabled" -eq 1 ]; then
    fail_usage "cannot combine --files with --global"
  fi

  if [ "$files_only" -eq 1 ] && [ "$strict_enabled" -eq 1 ]; then
    fail_usage "cannot combine --files with --strict"
  fi

  if [ "$files_only" -eq 1 ] && [ "$link_only" -eq 1 ]; then
    fail_usage "cannot combine --files with --link"
  fi

  if [ "$files_only" -eq 1 ] && [ "$check_only" -eq 1 ]; then
    fail_usage "cannot combine --files with -c"
  fi

  if [ "$files_only" -eq 1 ] && [ "$remove_only" -eq 1 ]; then
    fail_usage "cannot combine --files with -r"
  fi

  if [ "$files_only" -eq 1 ] && [ "$move_only" -eq 1 ]; then
    fail_usage "cannot combine --files with -mv"
  fi

  if [ "$files_only" -eq 1 ] && [ "$template_specified" -eq 1 ]; then
    fail_usage "cannot combine --files with --template"
  fi

  if [ "$template" != 'bash' ] && [ "$strict_enabled" -eq 1 ]; then
    fail_usage "--strict is only supported with the bash template"
  fi

  if [ "$template" != 'bash' ] && [ "$global_enabled" -eq 1 ]; then
    fail_usage "--global is only supported with the bash template"
  fi

  if [ "$template" != 'bash' ] && [ "$link_only" -eq 1 ]; then
    fail_usage "--link is only supported with the bash template"
  fi

  if [ "$template" != 'bash' ] && [ "$check_only" -eq 1 ]; then
    fail_usage "-c is only supported with the bash template"
  fi

  if [ "$template" != 'bash' ] && [ "$remove_only" -eq 1 ]; then
    fail_usage "-r is only supported with the bash template"
  fi

  if [ "$template" != 'bash' ] && [ "$move_only" -eq 1 ]; then
    fail_usage "-mv is only supported with the bash template"
  fi

  if [ "$files_only" -eq 1 ]; then
    rm -f "$stdin_terms_file"
    if [ "$files_mode" = 'lookup' ]; then
      lookup_requested_files "$lookup_terms_file"
      rm -f "$lookup_terms_file"
      exit $?
    fi

    list_script_files "$files_depth"
    rm -f "$lookup_terms_file"
    exit 0
  fi

  if [ "$move_only" -eq 1 ]; then
    move_script "$source" "$target" "$global_enabled"
    exit 0
  fi

  if [ "$check_only" -eq 1 ]; then
    check_global_link "$target"
  fi

  if [ "$remove_only" -eq 1 ]; then
    remove_global_link "$target"
    exit 0
  fi

  if [ "$link_only" -eq 1 ]; then
    validate_link_source "$target"
    link_path=$(global_link_path "$target")
    validate_global_link "$link_path"
    absolute_target=$(absolute_path "$target") || fail_create "failed to resolve absolute path: $target"
    confirm_link_action "$target" "$link_path"

    if ! create_global_link "$absolute_target" "$link_path"; then
      fail_create "failed to create global link: $link_path"
    fi

    printf 'Created global link: %s -> %s\n' "$link_path" "$absolute_target"
    exit 0
  fi

  validate_target "$target"

  if [ "$global_enabled" -eq 1 ]; then
    link_path=$(global_link_path "$target")
    validate_global_link "$link_path"
    absolute_target=$(absolute_path "$target") || fail_create "failed to resolve absolute path: $target"
  fi

  create_target "$target" "$template" "$strict_enabled"

  if [ "$global_enabled" -eq 1 ]; then
    if ! create_global_link "$absolute_target" "$link_path"; then
      cleanup_target "$target"
      fail_create "failed to create global link: $link_path"
    fi
  fi

  if [ "$template" = 'bash' ]; then
    printf 'Created script: %s\n' "$target"
  else
    printf 'Created file: %s\n' "$target"
  fi
  if [ "$global_enabled" -eq 1 ]; then
    printf 'Created global link: %s -> %s\n' "$link_path" "$absolute_target"
  fi
}

main "$@"
