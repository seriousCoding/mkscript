#Requires -Version 5.1
[CmdletBinding(PositionalBinding = $false)]
param([Parameter(ValueFromRemainingArguments = $true)][string[]] $Arguments)

$Version = '@VERSION@'
$Name = 'mkscript'
$UsageError = 64
$CreateError = 73

function Stop-Mkscript([string] $Message, [int] $Code = $CreateError) {
    [Console]::Error.WriteLine("${Name}: $Message")
    exit $Code
}

function Show-Help {
@'
Usage:
  mkscript [OPTION]... PATH
  mkscript -mv [--global] SOURCE TARGET
  mkscript -f|--files [DEPTH]
  mkscript -f|--files NAME [NAME ...]

Create a new Windows command, Docker, Kubernetes, Terraform, or Ansible file.
Global wrapper management applies to command scripts only.

Options:
  -t, --template TEMPLATE  use cmd, terraform, ansible, dockerfile, docker-compose,
                           k8s-namespace, k8s-pod, k8s-deployment, k8s-service,
                           k8s-configmap, k8s-secret, k8s-ingress, k8s-networkpolicy,
                           k8s-serviceaccount, k8s-role, k8s-rolebinding,
                           k8s-clusterrole, k8s-clusterrolebinding,
                           k8s-persistentvolume, k8s-persistentvolumeclaim,
                           k8s-storageclass, k8s-statefulset, k8s-daemonset,
                           k8s-job, k8s-cronjob, or k8s-horizontalpodautoscaler
  -f, --files              list or look up native Windows files/commands
  -mv                      move a command script and update its wrapper
  -s, --strict             enable delayed expansion in a generated .cmd file
  -g, --global             create a .cmd wrapper in the user bin directory
  -c                       check whether the expected wrapper exists
  -r                       remove the expected wrapper after confirmation
      --help               display this help and exit
      --version            output version information and exit
'@
}

function Resolve-FullPath([string] $Path) {
    return $ExecutionContext.SessionState.Path.GetUnresolvedProviderPathFromPSPath($Path)
}

function Get-UserBin {
    if ($env:MKSCRIPT_BIN_DIR) { return Resolve-FullPath $env:MKSCRIPT_BIN_DIR }
    if (-not $env:LOCALAPPDATA) { Stop-Mkscript 'LOCALAPPDATA is not set; cannot determine the user bin directory' }
    return [IO.Path]::Combine($env:LOCALAPPDATA, 'mkscript', 'bin')
}

function Get-CommandTarget([string] $Path) {
    if ([IO.Path]::GetExtension($Path)) { return $Path }
    return "$Path.cmd"
}

function Get-WrapperPath([string] $Target) {
    $leaf = [IO.Path]::GetFileNameWithoutExtension($Target)
    return [IO.Path]::Combine((Get-UserBin), "$leaf.cmd")
}

function Get-WrapperTarget([string] $Wrapper) {
    if (-not (Test-Path -LiteralPath $Wrapper -PathType Leaf)) { return $null }
    $first = Get-Content -LiteralPath $Wrapper -TotalCount 1 -ErrorAction SilentlyContinue
    if ($first -match '^@rem mkscript-wrapper: (.+)$') { return $Matches[1] }
    return $null
}

function Assert-WrapperAvailable([string] $Wrapper) {
    if (Test-Path -LiteralPath $Wrapper) { Stop-Mkscript "refusing to overwrite existing global path: $Wrapper" }
}

function Write-Wrapper([string] $Target, [switch] $Replace) {
    $absolute = Resolve-FullPath $Target
    $wrapper = Get-WrapperPath $Target
    $dir = Split-Path -Parent $wrapper
    if ((Test-Path -LiteralPath $dir) -and -not (Test-Path -LiteralPath $dir -PathType Container)) {
        Stop-Mkscript "global bin directory is not a directory: $dir"
    }
    if (-not $Replace) { Assert-WrapperAvailable $wrapper }
    New-Item -ItemType Directory -Path $dir -Force | Out-Null
    $ext = [IO.Path]::GetExtension($absolute).ToLowerInvariant()
    $invoke = if ($ext -eq '.ps1') {
        '@powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File "' + ($absolute -replace '"','""') + '" %*'
    } else { '@call "' + ($absolute -replace '"','""') + '" %*' }
    @("@rem mkscript-wrapper: $absolute", '@echo off', $invoke, '@exit /b %errorlevel%') |
        Set-Content -LiteralPath $wrapper -Encoding ASCII
    Write-Output "Created wrapper '$wrapper' for '$absolute'"
}

function Confirm([string] $Prompt) {
    $answer = Read-Host "$Prompt [y/N]"
    return $answer -match '^(?i:y|yes)$'
}

function Get-TemplateStem([string] $TargetName) {
    $leaf = [IO.Path]::GetFileName($TargetName)
    $stem = [IO.Path]::GetFileNameWithoutExtension($leaf)
    if ([string]::IsNullOrWhiteSpace($stem)) { return $leaf }
    return $stem
}

function Get-ManifestSafeName([string] $TargetName) {
    $stem = (Get-TemplateStem $TargetName).ToLowerInvariant()
    $normalized = $stem -replace '[\s_]+', '-' -replace '[^a-z0-9.-]', '-'
    $normalized = $normalized -replace '-{2,}', '-' -replace '\.{2,}', '.'
    $normalized = $normalized -replace '^[^a-z0-9]+', '' -replace '[^a-z0-9]+$', ''
    if ([string]::IsNullOrWhiteSpace($normalized)) {
        Stop-Mkscript "failed to derive a manifest-safe resource name from path: $TargetName"
    }
    return $normalized
}

function Get-StorageClassName([string] $TargetName) {
    return "$(Get-ManifestSafeName $TargetName)-storage"
}

function Write-NewFile([string] $Target, [string] $Template, [bool] $Strict) {
    $parent = Split-Path -Parent (Resolve-FullPath $Target)
    if (-not (Test-Path -LiteralPath $parent -PathType Container)) { Stop-Mkscript "parent directory does not exist: $parent" }
    if (Test-Path -LiteralPath $Target) { Stop-Mkscript "refusing to overwrite existing path: $Target" }
    $leaf = Split-Path -Leaf $Target
    $creator = [Environment]::UserName
    $date = Get-Date -Format 'yyyy-MM-dd'
    $resourceName = Get-ManifestSafeName $Target
    $storageClassName = Get-StorageClassName $Target
    $roleName = "$resourceName-role"
    $bindingName = "$resourceName-binding"
    $clusterRoleName = "$resourceName-clusterrole"
    $clusterBindingName = "$resourceName-clusterrolebinding"
    $serviceName = Get-ManifestSafeName $Target
    $hashHeader = @("# File: $leaf", '# Description:', "# Created: $date", "# Creator: $creator", '')
    switch ($Template) {
        'cmd' {
            $lines = @('@echo off', "rem Script: $leaf", 'rem Description:', "rem Created: $date", "rem Creator: $creator")
            if ($Strict) { $lines += 'setlocal EnableExtensions EnableDelayedExpansion' }
        }
        'terraform' { $lines = $hashHeader + @('terraform {', '  required_version = ">= 1.0.0"', '}') }
        'ansible' { $lines = $hashHeader + @('---', "- name: $leaf", '  hosts: all', '  gather_facts: false', '  tasks: []') }
        'dockerfile' { $lines = $hashHeader + @('FROM alpine:3.22', 'WORKDIR /app', 'COPY . .', 'CMD ["sh"]') }
        'docker-compose' { $lines = $hashHeader + @('services:', "  $serviceName:", '    image: nginx:1.29-alpine', '    ports:', '      - "8080:80"') }
        'k8s-namespace' { $lines = $hashHeader + @('apiVersion: v1', 'kind: Namespace', 'metadata:', "  name: $resourceName") }
        'k8s-pod' { $lines = $hashHeader + @('apiVersion: v1', 'kind: Pod', 'metadata:', "  name: $resourceName", '  labels:', "    app: $resourceName", 'spec:', '  containers:', "    - name: $resourceName", '      image: registry.k8s.io/pause:3.10') }
        'k8s-deployment' { $lines = $hashHeader + @('apiVersion: apps/v1', 'kind: Deployment', 'metadata:', "  name: $resourceName", 'spec:', '  replicas: 1', '  selector:', '    matchLabels:', "      app: $resourceName", '  template:', '    metadata:', '      labels:', "        app: $resourceName", '    spec:', '      containers:', "        - name: $resourceName", '          image: registry.k8s.io/pause:3.10') }
        'k8s-service' { $lines = $hashHeader + @('apiVersion: v1', 'kind: Service', 'metadata:', "  name: $resourceName", 'spec:', '  selector:', "    app: $resourceName", '  ports:', '    - port: 80', '      targetPort: 80') }
        'k8s-configmap' { $lines = $hashHeader + @('apiVersion: v1', 'kind: ConfigMap', 'metadata:', "  name: $resourceName", 'data: {}') }
        'k8s-secret' { $lines = $hashHeader + @('apiVersion: v1', 'kind: Secret', 'metadata:', "  name: $resourceName", 'type: Opaque', 'stringData: {}') }
        'k8s-ingress' { $lines = $hashHeader + @('apiVersion: networking.k8s.io/v1', 'kind: Ingress', 'metadata:', "  name: $resourceName", 'spec:', '  rules:', "    - host: $resourceName.example.com", '      http:', '        paths:', '          - path: /', '            pathType: Prefix', '            backend:', '              service:', "                name: $resourceName", '                port:', '                  number: 80') }
        'k8s-networkpolicy' { $lines = $hashHeader + @('apiVersion: networking.k8s.io/v1', 'kind: NetworkPolicy', 'metadata:', "  name: $resourceName", 'spec:', '  podSelector:', '    matchLabels:', "      app: $resourceName", '  policyTypes:', '    - Ingress', '  ingress: []') }
        'k8s-serviceaccount' { $lines = $hashHeader + @('apiVersion: v1', 'kind: ServiceAccount', 'metadata:', "  name: $resourceName") }
        'k8s-role' { $lines = $hashHeader + @('apiVersion: rbac.authorization.k8s.io/v1', 'kind: Role', 'metadata:', "  name: $roleName", "  namespace: $resourceName", 'rules: []') }
        'k8s-rolebinding' { $lines = $hashHeader + @('apiVersion: rbac.authorization.k8s.io/v1', 'kind: RoleBinding', 'metadata:', "  name: $bindingName", "  namespace: $resourceName", 'subjects:', '  - kind: ServiceAccount', "    name: $resourceName", "    namespace: $resourceName", 'roleRef:', '  apiGroup: rbac.authorization.k8s.io', '  kind: Role', "  name: $roleName") }
        'k8s-clusterrole' { $lines = $hashHeader + @('apiVersion: rbac.authorization.k8s.io/v1', 'kind: ClusterRole', 'metadata:', "  name: $clusterRoleName", 'rules: []') }
        'k8s-clusterrolebinding' { $lines = $hashHeader + @('apiVersion: rbac.authorization.k8s.io/v1', 'kind: ClusterRoleBinding', 'metadata:', "  name: $clusterBindingName", 'subjects:', '  - kind: ServiceAccount', "    name: $resourceName", "    namespace: $resourceName", 'roleRef:', '  apiGroup: rbac.authorization.k8s.io', '  kind: ClusterRole', "  name: $clusterRoleName") }
        'k8s-persistentvolume' { $lines = $hashHeader + @('apiVersion: v1', 'kind: PersistentVolume', 'metadata:', "  name: $resourceName-pv", 'spec:', '  capacity:', '    storage: 10Gi', '  accessModes:', '    - ReadWriteOnce', "  storageClassName: $storageClassName", '  hostPath:', "    path: /mnt/data/$resourceName") }
        'k8s-persistentvolumeclaim' { $lines = $hashHeader + @('apiVersion: v1', 'kind: PersistentVolumeClaim', 'metadata:', "  name: $resourceName-pvc", 'spec:', '  accessModes:', '    - ReadWriteOnce', '  resources:', '    requests:', '      storage: 10Gi', "  storageClassName: $storageClassName") }
        'k8s-storageclass' { $lines = $hashHeader + @('apiVersion: storage.k8s.io/v1', 'kind: StorageClass', 'metadata:', "  name: $storageClassName", 'provisioner: kubernetes.io/no-provisioner', 'volumeBindingMode: WaitForFirstConsumer') }
        'k8s-statefulset' { $lines = $hashHeader + @('apiVersion: apps/v1', 'kind: StatefulSet', 'metadata:', "  name: $resourceName", 'spec:', "  serviceName: $resourceName", '  replicas: 1', '  selector:', '    matchLabels:', "      app: $resourceName", '  template:', '    metadata:', '      labels:', "        app: $resourceName", '    spec:', '      containers:', "        - name: $resourceName", '          image: registry.k8s.io/pause:3.10') }
        'k8s-daemonset' { $lines = $hashHeader + @('apiVersion: apps/v1', 'kind: DaemonSet', 'metadata:', "  name: $resourceName", 'spec:', '  selector:', '    matchLabels:', "      app: $resourceName", '  template:', '    metadata:', '      labels:', "        app: $resourceName", '    spec:', '      containers:', "        - name: $resourceName", '          image: registry.k8s.io/pause:3.10') }
        'k8s-job' { $lines = $hashHeader + @('apiVersion: batch/v1', 'kind: Job', 'metadata:', "  name: $resourceName", 'spec:', '  template:', '    spec:', '      restartPolicy: Never', '      containers:', "        - name: $resourceName", '          image: busybox:1.36', '          command: ["sh", "-c", "echo job complete"]') }
        'k8s-cronjob' { $lines = $hashHeader + @('apiVersion: batch/v1', 'kind: CronJob', 'metadata:', "  name: $resourceName", 'spec:', '  schedule: "0 * * * *"', '  jobTemplate:', '    spec:', '      template:', '        spec:', '          restartPolicy: OnFailure', '          containers:', "            - name: $resourceName", '              image: busybox:1.36', '              command: ["sh", "-c", "echo cronjob complete"]') }
        'k8s-horizontalpodautoscaler' { $lines = $hashHeader + @('apiVersion: autoscaling/v2', 'kind: HorizontalPodAutoscaler', 'metadata:', "  name: $resourceName", 'spec:', '  scaleTargetRef:', '    apiVersion: apps/v1', '    kind: Deployment', "    name: $resourceName", '  minReplicas: 1', '  maxReplicas: 3', '  metrics:', '    - type: Resource', '      resource:', '        name: cpu', '        target:', '          type: Utilization', '          averageUtilization: 80') }
        default { Stop-Mkscript "unsupported template: $Template (expected cmd, terraform, ansible, dockerfile, docker-compose, or a supported k8s-* template)" $UsageError }
    }
    $lines | Set-Content -LiteralPath $Target -Encoding UTF8
    Write-Output "Created '$Target'"
}

function Find-Files([string[]] $Terms) {
    if ($Terms.Count -eq 0 -or ($Terms.Count -eq 1 -and $Terms[0] -match '^[0-9]$')) {
        $depth = if ($Terms.Count) { [int]$Terms[0] } else { [int]::MaxValue }
        $root = (Get-Location).Path
        Get-ChildItem -File -Recurse -ErrorAction SilentlyContinue | Where-Object {
            $relative = $_.FullName.Substring($root.Length).TrimStart('\')
            (($relative -split '\\').Count - 1) -le $depth -and $_.Extension -in '.cmd','.bat','.ps1','.sh'
        } | Sort-Object FullName | Format-Table @{n='PATH';e={$_.FullName}}, @{n='KIND';e={$_.Extension.TrimStart('.')}} -AutoSize
        return
    }
    $failed = $false
    $rows = foreach ($term in $Terms) {
        $item = Get-Item -LiteralPath $term -ErrorAction SilentlyContinue
        $kind = 'path'
        if (-not $item) {
            $command = Get-Command $term -CommandType Application,ExternalScript -ErrorAction SilentlyContinue | Select-Object -First 1
            if ($command) { $item = Get-Item -LiteralPath $command.Source; $kind = 'command' }
        }
        if (-not $item) {
            $item = Get-ChildItem -File -Recurse -Filter $term -ErrorAction SilentlyContinue | Sort-Object FullName | Select-Object -First 1
            $kind = 'file'
        }
        if ($item) { [pscustomobject]@{ QUERY=$term; FOUND='yes'; TYPE=$kind; LOCATION=$item.FullName; DIRECTORY=$item.DirectoryName } }
        else { $failed=$true; [pscustomobject]@{ QUERY=$term; FOUND='no'; TYPE='missing'; LOCATION='-'; DIRECTORY='-' } }
    }
    $rows | Format-Table -AutoSize
    if ($failed) { exit 1 }
}

$template = 'cmd'; $strict = $false; $global = $false; $mode = 'create'; $paths = @()
for ($i=0; $i -lt $Arguments.Count; $i++) {
    $argument=$Arguments[$i]
    if ($argument -eq '--help') { Show-Help; exit 0 }
    if ($argument -eq '--version') { Write-Output "$Name $Version"; exit 0 }
    if ($argument -in '-t','--template') { if (++$i -ge $Arguments.Count) { Stop-Mkscript 'missing template value' $UsageError }; $template=$Arguments[$i]; continue }
    if ($argument -in '-s','--strict') { $strict=$true; continue }
    if ($argument -in '-g','--global') { $global=$true; continue }
    if ($argument -in '-f','--files') { $mode='files'; continue }
    if ($argument -eq '-mv') { $mode='move'; continue }
    if ($argument -eq '-c') { $mode='check'; continue }
    if ($argument -eq '-r') { $mode='remove'; continue }
    if ($argument -like '-*') { Stop-Mkscript "unrecognized option: $argument" $UsageError }
    $paths += $argument
}

if ($mode -eq 'files') { Find-Files $paths; exit 0 }
if ($mode -eq 'move') {
    if ($paths.Count -ne 2 -or $strict -or $template -ne 'cmd') { Stop-Mkscript 'invalid -mv option combination' $UsageError }
    $source=Resolve-FullPath (Get-CommandTarget $paths[0]); $target=Get-CommandTarget $paths[1]
    if (-not (Test-Path -LiteralPath $source -PathType Leaf)) { Stop-Mkscript "cannot move missing path: $($paths[0])" }
    if (Test-Path -LiteralPath $target) { Stop-Mkscript "refusing to overwrite existing path: $target" }
    $oldWrapper=Get-WrapperPath $source; $wasGlobal=((Get-WrapperTarget $oldWrapper) -eq $source)
    $newWrapper=Get-WrapperPath $target
    if (($global -or $wasGlobal) -and $newWrapper -ne $oldWrapper) { Assert-WrapperAvailable $newWrapper }
    Move-Item -LiteralPath $source -Destination $target
    if ($wasGlobal) { Remove-Item -LiteralPath $oldWrapper -Force }
    if ($global -or $wasGlobal) { Write-Wrapper $target -Replace:($newWrapper -eq $oldWrapper) }
    Write-Output "Moved '$source' to '$(Resolve-FullPath $target)'"; exit 0
}
if ($paths.Count -ne 1) { Stop-Mkscript 'expected exactly one output path' $UsageError }
$target = if ($template -eq 'cmd') { Get-CommandTarget $paths[0] } else { $paths[0] }
$wrapper = Get-WrapperPath $target
if ($mode -eq 'check') {
    if ($global -or $strict) { Stop-Mkscript 'invalid -c option combination' $UsageError }
    $wrapped=Get-WrapperTarget $wrapper
    if ($wrapped) { Write-Output "Wrapper exists: $wrapper -> $wrapped"; exit 0 }
    if (Test-Path -LiteralPath $wrapper) { Stop-Mkscript "global path exists but is not an mkscript wrapper: $wrapper" }
    Write-Output "Wrapper does not exist: $wrapper"; exit 1
}
if ($mode -eq 'remove') {
    $wrapped=Get-WrapperTarget $wrapper
    if (-not $wrapped) { if (Test-Path $wrapper) { Stop-Mkscript "global path exists but is not an mkscript wrapper: $wrapper" }; Write-Output "Wrapper does not exist: $wrapper"; exit 1 }
    if (-not (Confirm "Remove wrapper '$wrapper'?")) { Stop-Mkscript 'wrapper removal cancelled' }
    Remove-Item -LiteralPath $wrapper -Force; Write-Output "Removed wrapper '$wrapper'"; exit 0
}
if ($template -notin 'cmd','terraform','ansible','dockerfile','docker-compose','k8s-namespace','k8s-pod','k8s-deployment','k8s-service','k8s-configmap','k8s-secret','k8s-ingress','k8s-networkpolicy','k8s-serviceaccount','k8s-role','k8s-rolebinding','k8s-clusterrole','k8s-clusterrolebinding','k8s-persistentvolume','k8s-persistentvolumeclaim','k8s-storageclass','k8s-statefulset','k8s-daemonset','k8s-job','k8s-cronjob','k8s-horizontalpodautoscaler') { Stop-Mkscript "unsupported template: $template (expected cmd, terraform, ansible, dockerfile, docker-compose, or a supported k8s-* template)" $UsageError }
if ($strict -and $template -ne 'cmd') { Stop-Mkscript '--strict is only supported with the cmd template' $UsageError }
if ($global -and $template -ne 'cmd') { Stop-Mkscript '--global is only supported with the cmd template' $UsageError }
if (Test-Path -LiteralPath $target) {
    if (-not $global) { Stop-Mkscript "refusing to overwrite existing path: $target" }
    if ($strict) { Stop-Mkscript 'cannot combine --strict with --global when wrapping an existing path' $UsageError }
    Assert-WrapperAvailable $wrapper
    if (-not (Confirm "Create wrapper '$wrapper' for '$target'?")) { Stop-Mkscript 'wrapper creation cancelled' }
    Write-Wrapper $target; exit 0
}
if ($global) { Assert-WrapperAvailable $wrapper }
Write-NewFile $target $template $strict
if ($global) { Write-Wrapper $target }
